ngx_addon_name=ngx_http_grpc_filter_module

if [ "$HTTP" = NO ]; then
    echo "$0: error: ngx_http_grpc_filter_module requires HTTP"
    exit 1
fi

if [ "$HTTP_GRPC" != YES ]; then
    echo "$0: error: ngx_http_grpc_filter_module requires HTTP grpc"
    exit 1
fi

if [ "$ngx_module_link" = DYNAMIC ]; then
    echo "$0: error: ngx_http_grpc_filter_module must be built with --add-module"
    exit 1
fi

have=NGX_HTTP_GRPC_FILTER . auto/have

GRPC_FILTER_INCS="$ngx_addon_dir"

GRPC_FILTER_SRCS="                                                          \
                $ngx_addon_dir/ngx_http_grpc_filter_module.c                \
                "

GRPC_FILTER_DEPS="                                                          \
                $ngx_addon_dir/ngx_http_grpc_filter_module.h                \
                "

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name="$ngx_addon_name"
    ngx_module_incs="$GRPC_FILTER_INCS"
    ngx_module_deps="$GRPC_FILTER_DEPS"
    ngx_module_srcs="$GRPC_FILTER_SRCS"
    ngx_module_libs=

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES $ngx_addon_name"
    HTTP_INCS="$HTTP_INCS $GRPC_FILTER_INCS"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $GRPC_FILTER_SRCS"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $GRPC_FILTER_DEPS"
fi
