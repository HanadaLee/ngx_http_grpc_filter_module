+# Record the optional core APIs before generating module signatures.
+for ngx_api in \
+    NGX_HTTP_REQUEST_TIMING:src/http/ngx_http_request.h \
+    NGX_HTTP_SSL_STRICT_SERVER_NAME_CORE:src/http/modules/ngx_http_ssl_module.h \
+    NGX_HTTP_PROXY_FILTER_CORE:src/http/modules/ngx_http_proxy_module.h \
+    NGX_HTTP_GRPC_FILTER_CORE:src/http/ngx_http.h \
+    NGX_HTTP_UPSTREAM_TIMING:src/http/ngx_http_upstream.h \
+    NGX_STREAM_UPSTREAM_TIMING:src/stream/ngx_stream_upstream.h \
+    NGX_HTTP_CACHE_PURGE_CORE:src/http/ngx_http_cache.h
+do
+    ngx_api_name=${ngx_api%%:*}
+    ngx_api_header=${ngx_api#*:}
+
+    if grep -q "^#define $ngx_api_name  *1$" "$ngx_api_header"; then
+        have=$ngx_api_name . auto/have
+    fi
+done
 
 
